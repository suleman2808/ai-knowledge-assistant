# Secrets — these must never enter an image layer.
.env
credentials.json
token.json

# Generated locally; the image rebuilds the vector store itself.
data/chroma/
data/*.db
data/*.sqlite3

# Local environment and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/

# Not needed at runtime.
.git/
.github/
.claude/
docs/
tests/
*.md
!README.md

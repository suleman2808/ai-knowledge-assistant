# Copy this file to `.env` and fill in the values.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# --- Required -----------------------------------------------------------
# Free key from https://console.groq.com  (no credit card required)
GROQ_API_KEY=gsk_replace_me

# --- LLM models (optional; sensible defaults shown) ---------------------
# Check the live catalogue with:  python -m scripts.list_models
# Providers retire models regularly, so verify these still exist.
#
# The workhorse model used by the specialist agents.
LLM_MODEL=openai/gpt-oss-120b
# A smaller, faster model for intent classification. Routing into three
# buckets does not need the large model, and this keeps us inside the free
# tier's per-minute rate limit.
ROUTER_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
# These are reasoning models: hidden reasoning tokens come out of the same
# budget as the visible reply, so a small cap yields an EMPTY answer.
# Keep this comfortably above what the reply alone would need.
LLM_MAX_TOKENS=1024
# Reasoning depth: low | medium | high.
LLM_REASONING_EFFORT=medium
ROUTER_REASONING_EFFORT=low

# --- Embeddings (run locally, no API key) -------------------------------
# 384-dimension model: small, fast on CPU, strong for short passages.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Runtime: "onnx" (default — no PyTorch, installs in seconds) or
# "sentence-transformers" (PyTorch; supports any Hugging Face model).
# Re-run `python -m scripts.ingest` after changing this.
EMBEDDING_BACKEND=onnx

# --- Storage paths ------------------------------------------------------
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=clinic_docs
DOCUMENTS_DIR=data/documents
ANALYTICS_DB=data/analytics.db

# --- Retrieval tuning ---------------------------------------------------
# How many chunks to pull per query.
RETRIEVAL_TOP_K=4
# Minimum similarity (0-1) for a chunk to count as relevant. Below this the
# Inquiry Agent says it does not know rather than guessing.
RETRIEVAL_MIN_SCORE=0.30
# "hybrid" (vector + BM25 keyword search) or "vector". Hybrid measurably
# improves recall on brand names and exact terms; see the README.
RETRIEVAL_MODE=hybrid

# --- Google Calendar (optional) -----------------------------------------
# Leave blank to run the Booking Agent against an in-memory fake calendar,
# so a fresh clone works with no Google Cloud setup.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
# The clinic's local time. Appointment times everywhere else in the app are
# wall-clock times in this zone; only the Google integration converts.
CLINIC_TIMEZONE=America/Los_Angeles

# --- Server -------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000

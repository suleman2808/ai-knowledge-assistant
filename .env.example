# Copy this file to `.env` and fill in the values.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.

# --- Required -----------------------------------------------------------
# Free key from https://console.groq.com  (no credit card required)
GROQ_API_KEY=gsk_replace_me

# --- LLM models (optional; sensible defaults shown) ---------------------
# The workhorse model used by the specialist agents.
LLM_MODEL=llama-3.3-70b-versatile
# A smaller, faster model for intent classification. Routing into three
# buckets does not need a 70B model, and this keeps us inside the free
# tier's per-minute rate limit.
ROUTER_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embeddings (run locally, no API key) -------------------------------
# 384-dimension model: small, fast on CPU, strong for short passages.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage paths ------------------------------------------------------
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=clinic_docs
DOCUMENTS_DIR=data/documents
ANALYTICS_DB=data/analytics.db

# --- Retrieval tuning ---------------------------------------------------
# How many chunks to pull per query.
RETRIEVAL_TOP_K=4
# Minimum similarity (0-1) for a chunk to count as relevant. Below this the
# Inquiry Agent says it does not know rather than guessing.
RETRIEVAL_MIN_SCORE=0.30

# --- Google Calendar (optional) -----------------------------------------
# Leave blank to run the Booking Agent against an in-memory fake calendar,
# so a fresh clone works with no Google Cloud setup.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# --- Server -------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
